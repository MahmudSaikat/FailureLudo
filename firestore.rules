rules_version = '2';

// FailureLudo — online multiplayer rules.
// The game engine is deterministic and runs on every client (moves are synced,
// not authoritative server state), so these rules enforce *authentication* and
// basic ownership rather than game correctness. Tighten further once a Cloud
// Function validates moves server-side.
service cloud.firestore {
  match /databases/{database}/documents {

    // Player profiles: anyone signed in can read (to show names/avatars);
    // only the owner may write their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Game rooms + their move log. Any signed-in user (including anonymous
    // guests and spectators) may read; any signed-in user may create/join/play.
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;

      match /moves/{moveId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
      }
    }
  }
}
