# Copy this file to keystore.properties (which is gitignored) and fill in your
# real release-signing credentials. Generate a keystore with:
#
#   keytool -genkeypair -v -keystore release-keystore.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias failureludo
#
# storeFile is resolved relative to the repository root.
storeFile=release-keystore.jks
storePassword=CHANGE_ME
keyAlias=failureludo
keyPassword=CHANGE_ME
</content>
